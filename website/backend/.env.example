# Backend Environment Configuration
# Copy this file to backend/.env and populate your credentials

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Security & CORS (Restricted to Next.js Frontend)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
RATE_LIMIT_PER_MINUTE=60

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=[".pdf", ".txt"]

# AI / LLM Orchestration (Optional - defaults to deterministic synthesis if omitted)
OPENAI_API_KEY=
LLM_API_BASE=http://localhost:11434/v1
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Vector Database (in_memory / chroma / qdrant)
VECTOR_DB_TYPE=in_memory
CHROMA_PERSIST_DIR=./data/chroma_db
