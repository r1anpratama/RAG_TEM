scratch/
temp/
*.tmp
*.tmp.md
*.draft.md
*.bak
*.swp
*.log

# Large binary / generated artifacts
data/processed/*.bin
data/processed/*.pkl
data/processed/*.parquet
*.hdf5
*.h5

