node_modules/
.next/
out/
build/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Secrets (Zero Exposure)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

