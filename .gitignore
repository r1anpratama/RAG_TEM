__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/

# IDE & OS Specific
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

